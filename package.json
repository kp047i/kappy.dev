{
  "name": "kappy.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:ci": "storybook dev -p 6006 --ci --no-open --disable-telemetry",
    "build-storybook": "storybook build",
    "test:unit": "vitest --project=unit",
    "test:storybook": "vitest --project=storybook",
    "test:e2e": "pnpm exec playwright test",
    "test": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm build && pnpm test:unit && pnpm build-storybook && pnpm test:storybook && pnpm test:e2e"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.3.0",
    "@next/third-parties": "16.3.0",
    "@vercel/analytics": "^1.4.1",
    "clsx": "^2.1.1",
    "glob": "^10.5.0",
    "jsdom": "^24.1.3",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-tweet": "^3.3.1",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.0",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-links": "10.5.8",
    "@storybook/addon-onboarding": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/nextjs-vite": "10.5.8",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsdom": "^21.1.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/rss": "^0.0.32",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-storybook": "10.5.8",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.0",
  "volta": {
    "node": "22.13.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "8.5.25",
      "sharp@<0.35.0": "0.35.3",
      "shell-quote@<1.9.0": "1.10.0",
      "uuid@<11.1.1": "11.1.1",
      "typescript-eslint": "^8.67.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
