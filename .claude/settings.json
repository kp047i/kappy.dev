{
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "STORYBOOK_DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600,
            "statusMessage": "依存関係をセットアップ中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f || exit 0; [ -n \"$f\" ] && pnpm exec prettier --ignore-unknown --write \"$f\"; } >/dev/null 2>&1 || true",
            "statusMessage": "prettier で整形中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:css)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm build-storybook*)",
      "Bash(pnpm test:unit*)",
      "Bash(pnpm test:storybook*)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec stylelint *)",
      "Bash(pnpm exec eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ]
  }
}
